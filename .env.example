# =============================================
# Job Hunter Bot - Ortam Değişkenleri Şablonu
# =============================================
# Bu dosyayı .env olarak kopyalayın ve doldurun:
#   cp .env.example .env

# Telegram Bot Token (@BotFather'dan alın)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (kendi chat ID'niz veya grup ID'si)
# Bulmak için: @userinfobot'a /start yazın
TELEGRAM_CHAT_ID=

# Tarama aralığı (dakika)
CHECK_INTERVAL_MINUTES=30

# Proxy URL (opsiyonel - LinkedIn/Indeed banlama riskini azaltır)
# Örnek: http://user:pass@proxy-host:port
# Boş bırakılırsa proxy kullanılmaz
PROXY_URL=

# SQLite veritabanı dosyası yolu
DB_PATH=jobs.db

# Log dosyası yolu
LOG_PATH=bot.log

# Sessiz saatler — bu aralıkta tarama yapılmaz, bildirim gönderilmez
# Format: HH:MM (Türkiye saati / Europe/Istanbul)
QUIET_START=00:00
QUIET_END=07:30

# Sirketler + program sayfalari: gece dahil kontrol (dakika)
COMPANY_INTERVAL_MINUTES=15
# Dogrudan Kariyer.net scraping varsayilan kapali.
KARIYER_ENABLED=false
# Proxy gerektirmeyen Is Habercisi e-postalari: yalniz ayrilmis klasor okunur.
KARIYER_IMAP_HOST=
KARIYER_IMAP_USER=
KARIYER_IMAP_PASSWORD=
KARIYER_IMAP_FOLDER=
