[Unit]
Description=Job Hunter Telegram Bot
After=network.target

[Service]
Type=simple
# !! Aşağıdaki yolları kendi kullanıcı adınıza göre düzenleyin !!
User=youruser
WorkingDirectory=/home/youruser/isapp
ExecStart=/home/youruser/isapp/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/youruser/isapp/bot.log
StandardError=append:/home/youruser/isapp/bot.log
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
